# 2. Making a REST API Request using Built-in Libraries
def fetch_public_data(url: str):
    print(f"\n--- Fetching Data from API ---")
    print(f"Target URL: {url}")
    
    try:
        # Sending an HTTP GET request using urllib
        with urllib.request.urlopen(url) as response:
            # Check if status code is 200 (OK)
            if response.status == 200:
                # Read binary data and decode it to a UTF-8 string
                raw_data = response.read().decode("utf-8")
                
                # Parse JSON string into a Python dictionary
                parsed_json = json.loads(raw_data)
                return parsed_json
            else:
                print(f"Failed with status code: {response.status}")
                return None
                
    except urllib.error.URLError as e:
        print(f"Network error occurred: {e.reason}")
        return None
    except Exception as e:
        print(f"An unexpected error occurred: {e}")
        return None

# --- Execution Section ---
# Using a public test API (JSONPlaceholder) to fetch dummy user data
api_url = "https://jsonplaceholder.typicode.com/users/1"
user_data = fetch_public_data(api_url)

if user_data:
    print("\n--- API Response Parsed Successfully ---")
